# Backend base URL (FastAPI). The client appends /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Route protection via src/proxy.ts. Keep "false" while the backend/auth isn't
# wired so the mock UI stays viewable; set "true" to redirect unauthenticated
# users to /login (requires the backend to set the refresh cookie).
NEXT_PUBLIC_AUTH_ENABLED=false
